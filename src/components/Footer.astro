---
import NMark from "./NMark.astro";

const links = [
  { href: "/products", label: "Products" },
  { href: "/studio", label: "Studio" },
  { href: "/about", label: "About" },
];
const year = 2026;
---
<footer class="nv-footer nv-edge-top" data-forming-scene>
  <NMark size={480} class="nv-footer__echo" data-forming-echo parallax={false} variant="logo" />
  <div class="nv-container">
    <p class="nv-footer__signoff nv-reveal">NUVYA</p>
    <div class="nv-footer__row">
      <a class="nv-footer__brand" href="/" aria-label="Nuvya, home">
        <NMark size={40} class="nv-footer__mark" variant="logo" />
        <span class="nv-footer__word">NUVYA</span>
      </a>
      <nav class="nv-footer__nav" aria-label="Footer">
        {links.map((link) => (
          <a class="nv-footer__link" href={link.href}>{link.label}</a>
        ))}
      </nav>
    </div>
    <div class="nv-footer__bottom">
      <span><span>&copy;</span> {year} Nuvya Technology Studios</span>
      <span>Independent technology studio</span>
    </div>
  </div>
</footer>
