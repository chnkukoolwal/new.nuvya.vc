---
interface Props {
  size?: number;
  class?: string;
  parallax?: boolean;
  decorative?: boolean;
}
const { size = 46, class: className = "", parallax = false, decorative = true } = Astro.props;
---
<img
  src="https://nuvyavc-logo.chinkukoolwal.workers.dev"
  width={size}
  height={Math.round(size * (569 / 848))}
  class={className}
  alt={decorative ? "" : "Nuvya"}
  aria-hidden={decorative ? "true" : undefined}
  loading="eager"
  decoding="async"
  data-nv-mark={parallax ? "" : undefined}
/>
