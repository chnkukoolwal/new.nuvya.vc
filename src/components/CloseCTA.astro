---
interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
---
<section class={`nv-close nv-edge-top ${full ? "" : "nv-close--compact"}`} aria-labelledby="build-heading">
  <h2 id="build-heading" class="nv-sr-only">Build with Nuvya</h2>
  <div class="nv-container">
    <div class="nv-close__inner">
      <p class="nv-close__wordmark nv-gradient-text nv-reveal nv-reveal--settle">Build with Nuvya.</p>
      <p class="nv-statement nv-reveal nv-reveal--d1" style="margin-top: var(--space-3);">
        Have an idea worth building?
      </p>
      <a class="nv-close__link nv-reveal nv-reveal--d2" href="mailto:chnkukoolwal@gmail.com">
        chnkukoolwal@gmail.com
      </a>
    </div>
  </div>
</section>
