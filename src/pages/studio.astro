---
import BaseLayout from "../layouts/BaseLayout.astro";
import CloseCTA from "../components/CloseCTA.astro";
import BackLink from "../components/BackLink.astro";

const process = [
  {
    title: "Conceive",
    body: "Identify ideas, problems, behaviours and technological opportunities worth pursuing.",
  },
  {
    title: "Design",
    body: "Obsess over the product experience, interaction and visual language before a line of production code exists.",
  },
  {
    title: "Build",
    body: "Turn a concept into a working product with speed and precision — velocity is a discipline the studio practices deliberately, not a shortcut it takes.",
  },
  {
    title: "Launch",
    body: "Ship into the real world, learn from usage and iterate — shipping matters more than announcing.",
  },
  {
    title: "Own",
    body: "Build products with the intention of creating enduring businesses and intellectual property, not deliverables.",
  },
];

const beliefs = [
  "Small teams can build enormous things.",
  "Software should feel inevitable.",
  "Design is not decoration.",
  "The fastest path is the deliberate one.",
  "The best products earn their complexity.",
  "Shipping matters more than announcing.",
];
---
<BaseLayout
  title="Studio"
  description="Nuvya conceives, designs, builds, launches and owns software products. This is how, and why."
  path="/studio"
>
  <section class="nv-intro">
    <div class="nv-container">
      <div class="nv-intro__inner">
        <BackLink href="/" label="Nuvya" />
        <p class="nv-kicker nv-reveal">Studio</p>
        <h1 class="nv-display nv-gradient-text nv-reveal nv-reveal--d1" style="margin-top: var(--space-3);">We build.</h1>
        <p class="nv-h2 nv-intro__statement" data-wipe>
          Nuvya conceives, designs, builds, launches and owns software products.
        </p>
      </div>
    </div>
  </section>

  <section class="nv-manifesto nv-edge-top" data-manifesto-scene aria-labelledby="process-heading">
    <p id="process-heading" class="nv-sr-only">Process</p>
    <div class="nv-manifesto__stage">
      <div class="nv-container nv-container--narrow">
        <div class="nv-manifesto__stack" data-manifesto-stack>
          {process.map((step, i) => (
            <div class="nv-manifesto__item">
              <span class="nv-numeral nv-manifesto__numeral">{String(i + 1).padStart(2, "0")}</span>
              <h2 class="nv-manifesto__title nv-gradient-text">{step.title}</h2>
              <p class="nv-lede nv-manifesto__body">{step.body}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="nv-manifesto__dots" data-manifesto-dots aria-hidden="true">
        {process.map(() => <span class="nv-manifesto__dot"></span>)}
      </div>
    </div>
  </section>

  <section class="nv-section nv-edge-top" aria-labelledby="beliefs-heading">
    <div class="nv-container nv-container--narrow">
      <p class="nv-kicker nv-reveal">We believe.</p>
      <h2 id="beliefs-heading" class="nv-sr-only">Beliefs</h2>
      <div class="nv-beliefs" style="margin-top: var(--space-7);">
        {beliefs.map((belief, i) => (
          <p class={`nv-belief ${i % 2 === 1 ? "nv-belief--offset" : ""}`} data-wipe>{belief}</p>
        ))}
      </div>
    </div>
  </section>

  <CloseCTA />
</BaseLayout>
