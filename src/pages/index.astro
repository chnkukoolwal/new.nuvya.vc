---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NMark from "../components/NMark.astro";
import CloseCTA from "../components/CloseCTA.astro";

const products = (await getCollection("products")).sort((a, b) => a.data.order - b.data.order);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Nuvya",
  alternateName: "Nuvya Technology Studios",
  url: "https://new.nuvya.vc/",
  logo: "https://nuvyavc-logo.chinkukoolwal.workers.dev",
  description: "Nuvya is a technology studio that builds products from first principles.",
};
---
<BaseLayout
  title="Nuvya Studios"
  description="Nuvya is a technology studio building products from first principles."
  structuredData={structuredData}
>
  <div class="nv-hero-scene" data-hero-scene>
    <section class="nv-hero" id="arrival" aria-label="Nuvya">
      <div class="nv-hero__stage" data-hero-stage>
        <div class="nv-hero__plate">
          <span class="nv-hero__plate-edge" aria-hidden="true"></span>
          <span class="nv-hero__mark-holder">
            <svg class="nv-hero__guides" data-hero-guides viewBox="0 0 140 140" aria-hidden="true">
              <path d="M6,20 L6,6 L20,6"/>
              <path d="M120,6 L134,6 L134,20"/>
              <path d="M134,120 L134,134 L120,134"/>
              <path d="M20,134 L6,134 L6,120"/>
            </svg>
            <NMark size={108} class="nv-hero__mark" parallax />
            <span class="nv-hero__mark-sweep" data-hero-sweep aria-hidden="true"></span>
          </span>

          <h1 class="nv-wordmark nv-gradient-text nv-hero__word">NUVYA</h1>
          <p class="nv-label nv-hero__label">Technology Studios</p>
          <p class="nv-statement nv-hero__statement">Technology, made tangible.</p>
        </div>
      </div>

      <span class="nv-hero__cue" aria-hidden="true">
        <span class="nv-hero__cue-line"></span>
      </span>
    </section>
  </div>

  <div class="nv-philosophy-scene" data-philosophy-scene>
    <section class="nv-philosophy nv-edge-top" id="philosophy" aria-labelledby="philosophy-heading" data-philosophy-stage>
      <span class="nv-philosophy__glow" aria-hidden="true"></span>
      <h2 id="philosophy-heading" class="nv-sr-only">Philosophy</h2>
      <div class="nv-philosophy__inner">
        <p class="nv-kicker nv-reveal">Philosophy</p>
        <div class="nv-philosophy__crossfade">
          <p class="nv-h2 nv-gradient-text nv-philosophy__statement" data-philosophy-text>
            Ideas become products here.
          </p>
          <p class="nv-h2 nv-gradient-text nv-philosophy__bridge" data-philosophy-bridge aria-hidden="true">
            The result.
          </p>
        </div>
      </div>
    </section>
  </div>

  <section class="nv-section" id="products" aria-labelledby="products-heading">
    <div class="nv-container">
      <div class="nv-section__head" data-scroll-emerge>
        <p class="nv-kicker">Products</p>
        <h2 id="products-heading" class="nv-display" style="margin-top: var(--space-3);">
          Selected Products
        </h2>
      </div>

      <div class="nv-product-list">
        {products.map((product, i) => (
          <a class="nv-product-row" href={`/products/${product.id}`} style={`--dot-color: ${product.data.color}`} data-scroll-emerge>
            <span class="nv-product-row__wash" aria-hidden="true"></span>
            <div class="nv-product-row__grid">
              <span class="nv-product-row__index-wrap">
                {product.data.heroImage && (
                  <span class="nv-product-row__icon-holder">
                    <img class="nv-product-row__icon" src={product.data.heroImage} alt="" width="96" height="96" loading="lazy" />
                  </span>
                )}
                <span class="nv-product-row__index nv-numeral">{String(i + 1).padStart(2, "0")}</span>
              </span>
              <span class="nv-product-row__name">{product.data.name}</span>
              <span class="nv-product-row__meta nv-meta">
                <span class="nv-status-dot"></span>
                {product.data.status}
              </span>
              <p class="nv-lede nv-product-row__tagline">{product.data.tagline}</p>
              <span class="nv-product-row__cta nv-arrow-link">Visit product <span aria-hidden="true">&rarr;</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="nv-section nv-section--tight nv-edge-top" id="studio" aria-labelledby="studio-heading">
    <div class="nv-container nv-container--narrow" style="text-align:center;">
      <p class="nv-kicker nv-reveal">Studio</p>
      <p id="studio-heading" class="nv-h2 nv-studio-kinetic" style="margin-top: var(--space-4);">
        <span class="nv-studio-word nv-gradient-text nv-reveal">Conceive.</span>
        <span class="nv-studio-word nv-reveal nv-reveal--d1">Design.</span>
        <span class="nv-studio-word nv-reveal nv-reveal--d2">Build.</span>
        <span class="nv-studio-word nv-reveal nv-reveal--d3">Launch.</span>
        <span class="nv-studio-word nv-gradient-text nv-reveal nv-reveal--d4">Own.</span>
      </p>
      <p class="nv-reveal nv-reveal--d4" style="margin-top: var(--space-6);">
        <a class="nv-arrow-link" href="/studio" style="justify-content:center;">How Nuvya builds <span aria-hidden="true">&rarr;</span></a>
      </p>
    </div>
  </section>

  <CloseCTA full />
</BaseLayout>
