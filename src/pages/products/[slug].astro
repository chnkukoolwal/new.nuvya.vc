---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CloseCTA from "../../components/CloseCTA.astro";
import BackLink from "../../components/BackLink.astro";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { data } = product;

const statusLabel: Record<string, string> = {
  building: "Building",
  launching: "Launching",
  live: "Live",
  archived: "Archived",
};

const statusCopy: Record<string, string> = {
  building: "In active development — not yet public.",
  launching: "Launching soon.",
  live: "Live now.",
  archived: "No longer active.",
};

const primaryCta = data.url
  ? { label: `Visit ${data.name}`, href: data.url }
  : data.appStoreUrl
  ? { label: "Get it on the App Store", href: data.appStoreUrl }
  : null;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: data.name,
  applicationCategory: data.category,
  description: data.oneLiner,
  ...(data.url ? { url: data.url } : {}),
  publisher: {
    "@type": "Organization",
    name: "Nuvya",
    url: "https://new.nuvya.vc/",
  },
};
---
<BaseLayout
  title={data.name}
  description={data.oneLiner}
  path={`/products/${product.id}`}
  structuredData={structuredData}
>
  <section class="nv-product-hero nv-container">
    <div class="nv-product-hero__inner">
      <BackLink href="/products" label="Products" />
      {data.heroImage && (
        <span class="nv-product-hero__icon-holder nv-reveal" style={`--dot-color: ${data.color}`}>
          <img class="nv-product-hero__icon" src={data.heroImage} alt="" width="88" height="88" loading="eager" />
        </span>
      )}
      <p class="nv-kicker nv-reveal">Product</p>
      <h1 class="nv-display nv-product-hero__name nv-reveal nv-reveal--d1">{data.name}</h1>
      <p class="nv-h2 nv-product-hero__tagline nv-reveal nv-reveal--d2">{data.tagline}</p>
      <p class="nv-lede nv-reveal nv-reveal--d2" style="margin-top: var(--space-4); max-width: 60ch;">
        {data.oneLiner}
      </p>
      <div class="nv-product-hero__status nv-reveal nv-reveal--d3">
        <span class="nv-status-dot" style={`--dot-color: ${data.color}`}></span>
        {statusLabel[data.status]} &middot; {data.category}
      </div>
      {primaryCta && (
        <p class="nv-reveal nv-reveal--d4" style="margin-top: var(--space-6);">
          <a class="nv-arrow-link" href={primaryCta.href}>{primaryCta.label} <span aria-hidden="true">&rarr;</span></a>
        </p>
      )}
    </div>
  </section>

  {data.sections.map((section, i) => (
    <section class="nv-product-section nv-edge-top">
      <div class="nv-container">
        <div class="nv-product-section__inner">
          <div class="nv-product-section__heading-wrap nv-reveal">
            <span class="nv-numeral nv-product-section__numeral">{String(i + 1).padStart(2, "0")}</span>
            <h2 class="nv-kicker nv-product-section__heading">{section.heading}</h2>
          </div>
          <p class="nv-lede nv-product-section__body nv-reveal nv-reveal--d1">{section.body}</p>
        </div>
      </div>
    </section>
  ))}

  {data.screenshots.length > 0 && (
    <section class="nv-product-experience nv-edge-top" aria-label={`${data.name} experience`}>
      <div class="nv-container">
        <p class="nv-kicker nv-reveal">Experience</p>
        <div class="nv-product-experience__frames" data-stagger-list>
          {data.screenshots.map((src) => (
            <div class="nv-product-experience__frame">
              <img src={src} alt="" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="nv-product-section nv-edge-top" aria-label={`${data.name} status`}>
    <div class="nv-container">
      <div class="nv-product-section__inner">
        <div class="nv-product-section__heading-wrap nv-reveal">
          <h2 class="nv-kicker nv-product-section__heading">Status</h2>
        </div>
        <div class="nv-product-section__body nv-reveal nv-reveal--d1">
          <p class="nv-lede">
            {statusCopy[data.status]}{data.launchDate ? ` ${data.launchDate}` : ""}
          </p>
          <div class="nv-product-links" style="margin-top: var(--space-6);">
            {data.url ? (
              <a class="nv-product-link-row" href={data.url}>
                <span class="nv-product-link-row__label">Website</span>
                <span class="nv-product-link-row__value">{data.url.replace(/^https?:\/\//, "")} <span aria-hidden="true">&rarr;</span></span>
              </a>
            ) : (
              <div class="nv-product-link-row nv-product-link-row--pending">
                <span class="nv-product-link-row__label">Website</span>
                <span class="nv-product-link-row__value">Coming soon</span>
              </div>
            )}
            {data.appStoreUrl ? (
              <a class="nv-product-link-row" href={data.appStoreUrl}>
                <span class="nv-product-link-row__label">App Store</span>
                <span class="nv-product-link-row__value">Download <span aria-hidden="true">&rarr;</span></span>
              </a>
            ) : (
              <div class="nv-product-link-row nv-product-link-row--pending">
                <span class="nv-product-link-row__label">App Store</span>
                <span class="nv-product-link-row__value">Coming soon</span>
              </div>
            )}
            {data.playStoreUrl && (
              <a class="nv-product-link-row" href={data.playStoreUrl}>
                <span class="nv-product-link-row__label">Google Play</span>
                <span class="nv-product-link-row__value">Download <span aria-hidden="true">&rarr;</span></span>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="nv-section nv-section--tight nv-edge-top" style="text-align:center;">
    <a class="nv-label nv-arrow-link nv-reveal" href="/studio" style="justify-content:center;">Built by Nuvya <span aria-hidden="true">&rarr;</span></a>
    <p class="nv-reveal nv-reveal--d1" style="margin-top: var(--space-7);">
      <a class="nv-arrow-link" href="/products" style="justify-content:center;">All products <span aria-hidden="true">&rarr;</span></a>
    </p>
  </section>

  <CloseCTA />
</BaseLayout>
